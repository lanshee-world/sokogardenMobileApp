<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:background="#858381"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/shape"
        android:fontFamily="cursive"
        android:text="💰Lumine💰"
        android:textAlignment="center"
        android:textColor="#F8DE81"
        android:textSize="45sp"
        android:textStyle="bold|italic" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

<!--    Below is a linear layout that aligns contents horizontally-->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👤 Join"
            android:textSize="25sp"
            android:padding="10dp"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="8dp"
            android:textColor="#234"
            android:layout_weight="1"
            android:backgroundTint="#55BDBDCC"
            android:id="@+id/signupBtn"/>

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👨‍💼 Signin"
            android:textSize="25sp"
            android:padding="10dp"
            android:layout_weight="1"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="8dp"
            android:textColor="#234"
            android:backgroundTint="#55BDBDCC"
            android:id="@+id/signinBtn"/>

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📜 Us"
            android:textSize="25sp"
            android:padding="10dp"
            android:layout_weight="1"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="8dp"
            android:textColor="#234"
            android:backgroundTint="#55BDBDCC"
            android:id="@+id/aboutBtn"/>




    </LinearLayout>

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/btnOpenLink"
        android:text="💸 lumine app"
        android:textSize="25sp"
        android:textColor="#234"
        android:backgroundTint="#55BDBDCC"
        android:padding="10dp"
        android:layout_marginTop="8dp" />

    </LinearLayout>

<!--    Below is our progress bar-->
    <ProgressBar
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/progressbar"/>

<!--    Below is our recyclerview-->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="602dp"
        tools:listitem="@layout/single_item" />


</LinearLayout>